# Copie para .env (chmod 600) e preencha. O .env NUNCA vai para o Git.
JEAN_DOMAIN=crm.example.com
TWENTY_TAG=v2.9.0

# Gere cada segredo no servidor: openssl rand -hex 24  (PG_PASSWORD) / openssl rand -base64 32 (ENCRYPTION_KEY)
PG_PASSWORD=
ENCRYPTION_KEY=

# E-mail (convites e recuperação de senha). Com EMAIL_DRIVER=logger nada é enviado.
EMAIL_DRIVER=smtp
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Jean CRM
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=

# Ativação controlada (docs/JEAN_PRODUCTION.md, seção 3). OBRIGATÓRIO, sem padrão:
#  1) durante a criação do primeiro administrador: só os IPs autorizados, separados por espaço
#     (ex.: JEAN_ALLOWED_IPS=203.0.113.10);
#  2) depois de confirmar o administrador: JEAN_ALLOWED_IPS=0.0.0.0/0 ::/0  e `docker compose up -d caddy`.
# Não use com proxy/CDN na frente (o IP visto seria o do proxy).
JEAN_ALLOWED_IPS=

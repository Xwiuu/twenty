# Copie para .env (chmod 600) e preencha. O .env NUNCA vai para o Git.
JEAN_DOMAIN=crm.example.com
TWENTY_TAG=v2.9.0

# Gere cada segredo no servidor: openssl rand -hex 24  (PG_PASSWORD) / openssl rand -base64 32 (ENCRYPTION_KEY)
PG_PASSWORD=
ENCRYPTION_KEY=

# E-mail (convites e recuperação de senha). Com EMAIL_DRIVER=logger nada é enviado.
EMAIL_DRIVER=smtp
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Jean CRM
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
